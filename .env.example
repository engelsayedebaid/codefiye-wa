# --- Database (Neon). `neon link` / `neon env pull` write these to .env.local automatically.
# Pooled URL: app queries. Direct URL: migrations, BullMQ queues and LISTEN/NOTIFY events.
# No Redis needed — queues (BullMQ Postgres backend) and events (LISTEN/NOTIFY) run on Postgres.
DATABASE_URL=postgres://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# --- Encryption key for session_auth (Signal keys) and webhook secrets.
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every linked session (all users must rescan QR).
AUTH_ENCRYPTION_KEY=

# --- API
API_PORT=4000
API_HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
# Emails that see the platform admin console (server-enforced). Comma-separated.
PLATFORM_ADMIN_EMAILS=you@example.com

# --- Neon Auth (written automatically by `neon deploy` / `neon env pull`).
# API verifies Better Auth JWTs against the JWKS; the dashboard signs users in at the base URL.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
VITE_NEON_AUTH_URL=

# --- Worker
# Unique and STABLE per worker (sessions are resumed by the worker that owns them). Defaults to hostname.
WORKER_ID=
WORKER_MAX_SESSIONS=100

# --- Send pacing (anti-ban). Random delay between messages per session.
SEND_MIN_DELAY_MS=1000
SEND_MAX_DELAY_MS=3000

# --- Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Dashboard (Vite)
VITE_API_URL=http://localhost:4000
