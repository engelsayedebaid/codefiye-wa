# Copy to .env (secrets) and/or .env.local (Neon URLs, e.g. from `neon env pull`). Both are git-ignored;
# every script loads .env then .env.local, later wins.

# --- Postgres (Neon) -----------------------------------------------------------------------------
# Pooled URL for app queries.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/wa?sslmode=require
# Direct URL for migrations and LISTEN/NOTIFY (PgBouncer drops LISTEN). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/wa?sslmode=require
# Optional: separate database for `pnpm test` integration suites (skipped when unset).
TEST_DATABASE_URL=

# --- Secrets -------------------------------------------------------------------------------------
# 32 bytes, base64 or hex. Encrypts WhatsApp auth state at rest. Losing it = every session must re-scan.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=
# Shared secret between API and workers for the internal RPC (min 16 chars).
WORKER_SECRET=

# --- API -----------------------------------------------------------------------------------------
API_PORT=4000            # PORT (if set, e.g. on Railway) wins
API_HOST=0.0.0.0
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
# Serve the built dashboard from the API (production). Absolute or relative to the API's cwd.
DASHBOARD_DIST=
LOG_LEVEL=info
# AI analysis of the chats (admins, /chats → ✨). Empty = the feature answers "not configured".
ANTHROPIC_API_KEY=
# Ad library (/ads, admins): a long-lived Meta user token of an identity-confirmed account (facebook.com/ID)
# with Ad Library API access. Empty = the library shows sample ads.
META_ADLIB_TOKEN=

# --- Worker --------------------------------------------------------------------------------------
# Keep stable across restarts so a restarted worker reclaims its sessions at once (default: hostname).
WORKER_ID=
# Default 127.0.0.1; on Railway (RAILWAY_PRIVATE_DOMAIN set) :: for its IPv6 private network.
WORKER_HOST=
WORKER_PORT=4100
# How the API reaches this worker (default http://127.0.0.1:WORKER_PORT, or http://<RAILWAY_PRIVATE_DOMAIN>:WORKER_PORT on Railway).
WORKER_URL=
WORKER_CAPACITY=100
# Whether this worker runs sessions. Default: yes when deployed (NODE_ENV=production or Railway), no on a
# dev machine — a local worker on the production database would open the same WhatsApp sessions as the
# deployed one, and WhatsApp logs a device out when it sees it connected twice. `true` to run them locally.
WORKER_CLAIM=
# Postgres connections shared by all sessions of the worker (pooled URL).
DB_POOL_MAX=20
# Conversation sync jobs running at once per worker (others wait their turn).
SYNC_CONCURRENCY=3
# Anti-ban pacing between consecutive sends of one session (README §4.4).
SEND_DELAY_MIN_MS=1000
SEND_DELAY_MAX_MS=3000
MEDIA_MAX_BYTES=67108864
BAILEYS_LOG_LEVEL=warn
# Ad library: Facebook & Instagram ads via Apify (free plan: $5/month of usage)
APIFY_TOKEN=
# Ad library: Google & YouTube ads via SerpApi (free plan: 250 searches/month)
SERPAPI_KEY=
