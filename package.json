{
  "name": "wa-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @wa/api --filter @wa/worker --filter @wa/dashboard dev",
    "dev:api": "pnpm --filter @wa/api dev",
    "dev:worker": "pnpm --filter @wa/worker dev",
    "dev:dashboard": "pnpm --filter @wa/dashboard dev",
    "poc": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/poc.ts",
    "bootstrap": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bootstrap.ts",
    "db:generate": "pnpm --filter @wa/db generate",
    "db:migrate": "pnpm --filter @wa/db migrate",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/qrcode-terminal": "0.12.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@neon/config": "1.8.2",
    "@neon/env": "1.4.7",
    "@wa/db": "workspace:*",
    "@wa/provider": "workspace:*",
    "@wa/shared": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "10.3.1",
    "qrcode-terminal": "0.12.0"
  }
}
